{
  "name": "orbit-exchange",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env scripts/run-app.ts dev",
    "build": "next build",
    "start": "tsx --env-file-if-exists=.env scripts/run-app.ts start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:init": "tsx --env-file-if-exists=.env scripts/init-db.ts",
    "market:worker": "tsx --env-file-if-exists=.env scripts/market-worker.ts",
    "format": "prettier --write app components lib scripts tests e2e *.ts *.mjs *.json README.md",
    "account:balance": "tsx --env-file-if-exists=.env scripts/set-account-balance.ts",
    "verify:live": "tsx --env-file-if-exists=.env scripts/verify-live.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.6.2",
    "decimal.js": "^10.6.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "ws": "^8.22.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  }
}
