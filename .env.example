DATABASE_PATH=./data/orbit.sqlite
MAKER_FEE=0.001
TAKER_FEE=0.0015
PAPER_SLIPPAGE_BPS=2
MAX_QUOTE_AGE_MS=10000
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_URL=wss://data-stream.binance.vision:443
# Enable when serving over HTTPS. localhost HTTP needs false.
COOKIE_SECURE=false
PORT=3000
# Recommended behind a reverse proxy; preserve the public Host header.
# APP_ORIGIN=https://orbit.example.com
# Vercel web only: set at build time to your persistent backend HTTPS origin.
# Leave unset on the backend and for ordinary local development.
# ORBIT_BACKEND_URL=https://orbit-backend.example.com
